{
  "name": "lali-template",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev:backend": "cross-env INNGEST_DEV=1 tsx src/server.ts",
    "dev:agent": "inngest dev -u http://127.0.0.1:3000/api/inngest",
    "dev:web": "npm run dev --prefix web",
    "dev": "concurrently -n backend,agent,web -c blue,yellow,magenta \"npm run dev:backend\" \"npm run dev:agent\" \"npm run dev:web\"",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "inngest": "^4.21.0",
    "resend": "^6.31.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "inngest-cli": "^1.45.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}